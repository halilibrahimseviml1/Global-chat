-- ============ 7. POLLING INCOMING MESSAGES ============
local lastProcessedId = 0

task.spawn(function()
    while task.wait(3) do
        if http_request then
            local success, response = pcall(function()
                return http_request({ Url = API_URL .. "/get", Method = "GET" })
            end)
            
            if success and response and response.Body then
                local decodeSuccess, data = pcall(function()
                    return HttpService:JSONDecode(response.Body)
                end)
                
                if decodeSuccess and type(data) == "table" then
                    for _, msg in ipairs(data) do
                        if msg.id and msg.id > lastProcessedId then
                            lastProcessedId = msg.id

                            if msg.message and msg.message:lower() == "hi" then
                                addMessage(msg.sender, msg.senderId, msg.message, false, false)
                                addSystemMessage("Hi. If you want to try it, here is my new admin script: https://scriptblox.com/script/Universal-Script-Universal-Admin-Script-V3-(No-key-All-Commands)-227208", true, "https://scriptblox.com/script/Universal-Script-Universal-Admin-Script-V3-(No-key-All-Commands)-227208")
                            else
                                addMessage(msg.sender, msg.senderId, msg.message, msg.isCommand or false, false)
                            end

                            if msg.message and msg.message:find("banned user:") then
                                local target = msg.message:match("banned user: (.+)$")
                                if target and target ~= "halilibrahimseviml1" and moderators[target] ~= true then
                                    settings.bannedUsers[target] = true
                                    if updateBlacklistUI then updateBlacklistUI() end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

