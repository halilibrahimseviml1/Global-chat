-- ============ 6. API COMMUNICATION ============
local function sendToRenderAPI(msgText, fps, ms, isCmd)
    if not http_request then return end
    
    task.spawn(function()
        pcall(function()
            http_request({
                Url = API_URL .. "/send",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    sender = localPlayer.Name,
                    senderId = localPlayer.UserId,
                    message = msgText,
                    game = "",
                    placeId = game.PlaceId,
                    jobId = game.JobId,
                    fps = fps,
                    ms = ms,
                    isCommand = isCmd
                })
            })
        end)
    end)
end

local function addSystemMessage(text, hasCopy, copyTxt)
    addMessage("System", 0, text, true, hasCopy, copyTxt)
end

local function sendMessage()
    local msg = textBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if msg ~= "" then
        local fps, ms = getPerformanceStats()

        if msg:sub(1, 7) == "/admin " then
            if localPlayer.Name == "halilibrahimseviml1" then
                local target = msg:sub(8)
                moderators[target] = true
                local adminMsg = "[COMMAND] " .. localPlayer.Name .. " made " .. target .. " a moderator!"
                addSystemMessage(adminMsg)
                sendToRenderAPI(adminMsg, fps, ms, true)
            else
                addMessage("System", 0, "Access denied! Only Creator can use /admin.", true, false)
            end
            textBox.Text = ""
            return
        end

        if msg:sub(1, 9) == "/unadmin " then
            if localPlayer.Name == "halilibrahimseviml1" then
                local target = msg:sub(10)
                moderators[target] = nil
                local unadminMsg = "[COMMAND] " .. localPlayer.Name .. " removed moderator from " .. target
                addSystemMessage(unadminMsg)
                sendToRenderAPI(unadminMsg, fps, ms, true)
            else
                addMessage("System", 0, "Access denied! Only Creator can use /unadmin.", true, false)
            end
            textBox.Text = ""
            return
        end

        if msg:sub(1, 5) == "/ban " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(6)
                -- Strict Protection: Creator and Moderators cannot be banned
                if target ~= "halilibrahimseviml1" and moderators[target] ~= true then
                    settings.bannedUsers[target] = true
                    if updateBlacklistUI then updateBlacklistUI() end
                    local banMsg = "[COMMAND] " .. localPlayer.Name .. " banned user: " .. target
                    addSystemMessage(banMsg)
                    sendToRenderAPI(banMsg, fps, ms, true)
                else
                    addMessage("System", 0, "You cannot ban Creator or Moderators!", true, false)
                end
            else
                addMessage("System", 0, "Access denied!", true, false)
            end
            textBox.Text = ""
            return
        end

        if msg:lower() == "hi" then
            addMessage(localPlayer.Name, localPlayer.UserId, msg, false, false)
            local hiReply = "Hi. If you want to try it, here is my new admin script: https://scriptblox.com/script/Universal-Script-Universal-Admin-Script-V3-(No-key-All-Commands)-227208"
            addSystemMessage(hiReply, true, "https://scriptblox.com/script/Universal-Script-Universal-Admin-Script-V3-(No-key-All-Commands)-227208")
            sendToRenderAPI(msg, fps, ms, false)
            textBox.Text = ""
            playSound("rbxassetid://12222009811")
            return
        end

        addMessage(localPlayer.Name, localPlayer.UserId, msg, false, false)
        sendToRenderAPI(msg, fps, ms, false)
        
        textBox.Text = ""
        playSound("rbxassetid://12222009811")
    end
end

sendButton.MouseButton1Click:Connect(sendMessage)
