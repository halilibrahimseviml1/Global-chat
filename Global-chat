local function playSound(id)
    if settings.enableSounds then
        local sound = Instance.new("Sound")
        sound.SoundId = id
        sound.Volume = 0.5
        sound.Parent = screenGui
        sound:Play()
        game:GetService("Debris"):AddItem(sound, 2)
    end
end

local function addMessage(senderName, senderId, messageText, gameName, isSystem)
    if settings.bannedUsers[senderName] then return end

    if #messageText > settings.messageLimit then
        messageText = messageText:sub(1, settings.messageLimit) .. "..."
    end

    if settings.enableWordFilter and not isSystem then
        for _, word in ipairs(settings.bannedWords) do
            messageText = messageText:gsub(word, string.rep("*", #word))
        end
    end

    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, -10, 0, 35)
    msgFrame.BackgroundTransparency = 1
    msgFrame.Parent = scrollingFrame

    local avatarImg = Instance.new("ImageLabel")
    avatarImg.Size = UDim2.new(0, 28, 0, 28)
    avatarImg.Position = UDim2.new(0, 2, 0, 2)
    avatarImg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    avatarImg.BorderSizePixel = 0
    avatarImg.Parent = msgFrame

    local avatarCorner = Instance.new("UICorner")
    avatarCorner.CornerRadius = UDim.new(1, 0)
    avatarCorner.Parent = avatarImg

    if senderId and tonumber(senderId) > 0 then
        pcall(function()
            local content, isReady = Players:GetUserThumbnailAsync(tonumber(senderId), Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            if isReady then avatarImg.Image = content end
        end)
    else
        avatarImg.Image = "rbxassetid://6031075931"
    end

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "MessageText"
    textLabel.Size = UDim2.new(1, -35, 1, 0)
    textLabel.Position = UDim2.new(0, 35, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextSize = settings.fontSize

    local displayName = senderName
    local textColor = Color3.fromRGB(255, 255, 255)

    if senderName == "halilibrahimseviml1" then
        textColor = Color3.fromRGB(255, 50, 50)
        displayName = "[👑 Creator] " .. senderName
    elseif moderators[senderName] then
        textColor = Color3.fromRGB(0, 170, 255)
        displayName = "[🛡️ Mod] " .. senderName
    elseif isSystem then
        textColor = Color3.fromRGB(255, 200, 100)
        displayName = "[System]"
    else
        textColor = Color3.fromRGB(200, 200, 200)
    end

    textLabel.TextColor3 = textColor

    local timestamp = settings.enableTimestamps and not isSystem and "[" .. os.date("%H:%M") .. "] " or ""
    local gameTag = (gameName and gameName ~= "") and " (" .. gameName .. ")" or ""

    textLabel.Text = timestamp .. displayName .. gameTag .. ": " .. tostring(messageText)
    textLabel.Parent = msgFrame

    local textBounds = game:GetService("TextService"):GetTextSize(textLabel.Text, settings.fontSize, textLabel.Font, Vector2.new(textLabel.AbsoluteSize.X, 500))
    if textBounds.Y > 25 then
        msgFrame.Size = UDim2.new(1, -10, 0, textBounds.Y + 5)
    end
end

-- ============ 7. API COMMUNICATION (WITH TELEMETRY) ============
local function sendToRenderAPI(msgText, currentAppGame, fps, ms, isCmd)
    if not http_request then return end
    
    task.spawn(function()
        pcall(function()
            http_request({
                Url = API_URL .. "/send",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    sender = localPlayer.Name,
                    senderId = localPlayer.UserId,
                    message = msgText,
                    game = currentAppGame,
                    placeId = game.PlaceId,
                    jobId = game.JobId,
                    fps = fps,
                    ms = ms,
                    isCommand = isCmd
                })
            })
        end)
    end)
end

local function sendMessage()
    local msg = textBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if msg ~= "" then
        local fps, ms = getPerformanceStats()

        -- Creator Command: /admin [username]
        if msg:sub(1, 7) == "/admin " then
            if localPlayer.Name == "halilibrahimseviml1" then
                local target = msg:sub(8)
                moderators[target] = true
                local adminMsg = "[COMMAND] " .. localPlayer.Name .. " made " .. target .. " a moderator!"
                addSystemMessage(adminMsg)
                sendToRenderAPI(adminMsg, currentGameName, fps, ms, true)
            else
                addMessage("System", 0, "Access denied! Only Creator can use /admin.", "", true)
            end
            textBox.Text = ""
            return
        end

        -- Command: /ban [username]
        if msg:sub(1, 5) == "/ban " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(6)
                settings.bannedUsers[target] = true
                local banMsg = "[COMMAND] " .. localPlayer.Name .. " banned user: " .. target
                addSystemMessage(banMsg)
                sendToRenderAPI(banMsg, currentGameName, fps, ms, true)
            else
                addMessage("System", 0, "Access denied!", "", true)
            end
            textBox.Text = ""
            return
        end

        -- Command: /join [username]
        if msg:sub(1, 6) == "/join " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(7)
                local userData = activeUserData[target]
                if userData and userData.placeId and userData.jobId then
                    addMessage("System", 0, "Joining " .. target .. "'s server...", "", true)
                    TeleportService:TeleportToPlaceInstance(userData.placeId, userData.jobId, localPlayer)
                else
                    addMessage("System", 0, "No active server data found for: " .. target, "", true)
                end
            else
                addMessage("System", 0, "Access denied!", "", true)
            end
            textBox.Text = ""
            return
        end

        -- Command: /info [username]
        if msg:sub(1, 6) == "/info " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(7)
                local userData = activeUserData[target]
                if userData then
                    addMessage("System", 0, string.format("INFO [%s] | Game: %s | FPS: %d | MS: %d", target, userData.game, userData.fps or 0, userData.ms or 0), "", true)
                else
                    addMessage("System", 0, "No telemetry data found for: " .. target, "", true)
                end
            else
                addMessage("System", 0, "Access denied!", "", true)
            end
            textBox.Text = ""
            return
        end

        addMessage(localPlayer.Name, localPlayer.UserId, msg, currentGameName, false)
        sendToRenderAPI(msg, currentGameName, fps, ms, false)
        
        textBox.Text = ""
        playSound("rbxassetid://12222009811")
    end
end

function addSystemMessage(text)
    addMessage("System", 0, text, "", true)
end

sendButton.MouseButton1Click:Connect(sendMessage)
textBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessage() end
end)

-- ============ 8. POLLING INCOMING MESSAGES & TELEMETRY ============
local lastProcessedId = 0

task.spawn(function()
    while task.wait(3) do
        if http_request then
            local success, response = pcall(function()
                return http_request({ Url = API_URL .. "/get", Method = "GET" })
            end)
            
            if success and response and response.Body then
                local decodeSuccess, data = pcall(function()
                    return HttpService:JSONDecode(response.Body)
                end)
                
                if decodeSuccess and type(data) == "table" then
                    for _, msg in ipairs(data) do
                        if msg.id and msg.id > lastProcessedId then
                            lastProcessedId = msg.id
                            
                            -- Cache telemetry details for /join and /info
                            activeUserData[msg.sender] = {
                                placeId = msg.placeId,
                                jobId = msg.jobId,
                                game = msg.game or "Roblox",
                                fps = msg.fps,
                                ms = msg.ms
                            }

                            -- Handle remote commands execution globally
                            if msg.isCommand then
                                if msg.message:find("banned user:") then
                                    local target = msg.message:match("banned user: (.+)$")
                                    if target then
                                        settings.bannedUsers[target] = true
                                    end
                                elseif msg.message:find("made") and msg.message:find("a moderator!") then
                                    local target = msg.message:match("%[COMMAND%] .+ made (.+) a moderator!$")
                                    if target then
                                        moderators[target] = true
                                    end
                                end
                            end

                            addMessage(msg.sender, msg.senderId, msg.message, msg.game or "Roblox", msg.isCommand or false)
                        end
                    end
                end
            end
        end
    end
end)

