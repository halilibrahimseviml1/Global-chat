-- RGB Animation Loop for Creator
local creatorColor = Color3.fromRGB(255, 50, 50)
task.spawn(function()
    while true do
        local t = tick() * 2
        local r = math.sin(t) * 127 + 128
        local g = math.sin(t + 2) * 127 + 128
        local b = math.sin(t + 4) * 127 + 128
        creatorColor = Color3.fromRGB(r, g, b)
        task.wait(0.05)
    end
end)

-- Calculate FPS & MS securely and accurately
local lastUpdate = tick()
local frameCount = 0
local currentFPS = 60
local currentMS = 50

RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    if tick() - lastUpdate >= 1 then
        currentFPS = frameCount
        currentMS = math.floor(dt * 1000)
        frameCount = 0
        lastUpdate = tick()
    end
end)

local function getPerformanceStats()
    return currentFPS, currentMS
end

-- Permission check function
local function hasPermission(playerName)
    return playerName == "halilibrahimseviml1" or moderators[playerName] == true
end

-- Clipboard helper
local function copyToClipboard(text)
    pcall(function()
        if setclipboard then
            setclipboard(text)
        end
    end)
end

