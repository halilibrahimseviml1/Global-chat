-- Calculate FPS & MS securely and accurately
local lastUpdate = tick()
local frameCount = 0
local currentFPS = 60
local currentMS = 50

RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    if tick() - lastUpdate >= 1 then
        currentFPS = frameCount
        currentMS = math.floor(dt * 1000)
        frameCount = 0
        lastUpdate = tick()
    end
end)

local function getPerformanceStats()
    return currentFPS, currentMS
end

